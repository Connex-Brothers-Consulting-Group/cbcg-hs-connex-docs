{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CONNEX",
  "appearance": {
    "default": "dark"
  },
  "colors": {
    "primary": "#003DB3",
    "light": "#003DB3",
    "dark": "#D55E08"
  },
  "favicon": {
    "light": "/ci/favicon-light.webp",
    "dark": "/ci/favicon-dark.webp"
  },
  "logo": {
    "light": "/ci/logo-light.webp",
    "dark": "/ci/logo-dark.webp"
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/get-started/quickstart"
    },
    {
      "source": "/architecture",
      "destination": "/get-started/architecture"
    },
    {
      "source": "/releases",
      "destination": "/support/releases"
    },
    {
      "source": "/notices",
      "destination": "/support/notices"
    },
    {
      "source": "/faq",
      "destination": "/support/faq"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "CONNEX",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "get-started/overview",
              "get-started/quickstart",
              "get-started/architecture"
            ]
          },
          {
            "group": "Core Engines",
            "pages": [
              "features/agent",
              "features/coworx",
              "features/brains",
              "features/vfs"
            ]
          }
        ]
      },
      {
        "tab": "User Guides",
        "groups": [
          {
            "group": "Core User Manuals",
            "pages": [
              "guide/workspace/manual",
              "guide/agent/manual",
              "guide/coworx/manual",
              "guide/brains/manual",
              "guide/studio/manual"
            ]
          }
        ]
      },
      {
        "tab": "Use Cases",
        "groups": [
          {
            "group": "Enterprise Solutions",
            "pages": [
              "use-cases/business-management",
              "use-cases/legal-and-tax",
              "use-cases/rnd-and-patents",
              "use-cases/education-and-training",
              "use-cases/healthcare-and-lifestyle"
            ]
          }
        ]
      },
      {
        "tab": "Pricing",
        "groups": [
          {
            "group": "Plans & Capital Allocation",
            "pages": [
              "pricing/subscription-plans",
              "pricing/pay-as-you-go",
              "pricing/token-capital-allocation"
            ]
          }
        ]
      },
      {
        "tab": "Compliance",
        "groups": [
          {
            "group": "Trust & Sovereignty (SOC 2)",
            "pages": [
              "governance/compliance",
              "governance/data-sovereignty",
              "governance/zero-trust-auth",
              "governance/cloud-security"
            ]
          },
          {
            "group": "Legal & Terms",
            "pages": [
              "governance/terms-of-service",
              "governance/privacy-policy",
              "governance/billing-and-refund",
              "governance/marketing-policy"
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Support & Operations",
            "pages": [
              "resources/docs-center-guide",
              "resources/support-desk",
              "support/notices",
              "support/faq",
              "support/releases"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "groups": [
          {
            "group": "Public APIs & Protocols",
            "pages": [
              "developers/overview",
              "developers/authentication-api",
              "developers/vfs-api",
              "developers/coworx-webhooks",
              "developers/streaming-protocol"
            ]
          },
          {
            "group": "Model Context Protocol (MCP)",
            "pages": [
              "developers/mcp-server-spec",
              "developers/mcp-tool-catalog"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Launch CONNEX",
          "href": "https://connex.hybridsphere.io",
          "icon": "globe"
        },
        {
          "anchor": "Docs GitHub",
          "href": "https://github.com/Connex-Brothers-Consulting-Group/cbcg-hs-connex-docs",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Notices",
        "href": "/support/notices"
      },
      {
        "label": "FAQ",
        "href": "/support/faq"
      },
      {
        "label": "Release Notes",
        "href": "/support/releases"
      },
      {
        "label": "Support",
        "href": "mailto:support@connexbrothers.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch CONNEX",
      "href": "https://connex.hybridsphere.io"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Connex-Brothers-Consulting-Group/cbcg-hs-connex-docs"
    }
  },
  "description": "Enterprise Agentic Cloud Workspace OS Platform 2.0",
  "icons": {
    "library": "lucide"
  }
}
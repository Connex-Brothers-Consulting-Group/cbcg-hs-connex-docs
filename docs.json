{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CONNEX Cloud OS",
  "colors": {
    "primary": "#003DB3",
    "light": "#D55E08",
    "dark": "#002266"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "시작하기 (Getting Started)",
        "pages": [
          "index",
          "quickstart",
          "architecture"
        ]
      },
      {
        "group": "핵심 기능 (Core Features)",
        "pages": [
          "features/coworx",
          "features/agent",
          "features/vfs"
        ]
      },
      {
        "group": "거버넌스 & 보안 (Governance & Security)",
        "pages": [
          "governance/data-sovereignty",
          "governance/zero-trust-auth",
          "governance/compliance"
        ]
      },
      {
        "group": "릴리즈 & 지원 (Releases & Support)",
        "pages": [
          "releases",
          "notices",
          "faq"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "CONNEX Web App",
          "href": "https://connex.cloud",
          "icon": "globe"
        },
        {
          "anchor": "HybridSphere Portal",
          "href": "https://hybridsphere.io",
          "icon": "shield-check"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "릴리즈 노트",
        "href": "/releases"
      },
      {
        "label": "공지사항",
        "href": "/notices"
      },
      {
        "label": "자주 묻는 질문",
        "href": "/faq"
      },
      {
        "label": "지원 문의",
        "href": "mailto:support@hybridsphere.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "CONNEX 시작하기",
      "href": "https://connex.cloud"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Connex-Brothers-Consulting-Group"
    }
  }

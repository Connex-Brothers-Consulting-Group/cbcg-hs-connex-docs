{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CONNEX",
  "appearance": {
    "default": "dark"
  },
  "colors": {
    "primary": "#003DB3",
    "light": "#003DB3",
    "dark": "#D55E08"
  },
  "favicon": {
    "light": "/ci/favicon-light.webp",
    "dark": "/ci/favicon-dark.webp"
  },
  "logo": {
    "light": "/ci/logo-light.webp",
    "dark": "/ci/logo-dark.webp"
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/get-started/quickstart"
    },
    {
      "source": "/architecture",
      "destination": "/get-started/architecture"
    },
    {
      "source": "/releases",
      "destination": "/support/releases"
    },
    {
      "source": "/notices",
      "destination": "/support/notices"
    },
    {
      "source": "/faq",
      "destination": "/support/faq"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "get-started/quickstart",
              "get-started/architecture"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "features/coworx",
              "features/agent",
              "features/vfs"
            ]
          },
          {
            "group": "Security & Tenancy",
            "pages": [
              "governance/data-sovereignty",
              "governance/zero-trust-auth",
              "governance/compliance"
            ]
          }
        ]
      },
      {
        "tab": "Releases & Support",
        "groups": [
          {
            "group": "Ecosystem Updates",
            "pages": [
              "support/releases",
              "support/notices",
              "support/faq"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "CONNEX Web App",
          "href": "https://connex.cloud",
          "icon": "globe"
        },
        {
          "anchor": "HybridSphere Portal",
          "href": "https://hybridsphere.io",
          "icon": "shield-check"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Releases",
        "href": "/support/releases"
      },
      {
        "label": "Notices",
        "href": "/support/notices"
      },
      {
        "label": "FAQ",
        "href": "/support/faq"
      },
      {
        "label": "Support",
        "href": "mailto:support@hybridsphere.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch CONNEX",
      "href": "https://connex.cloud"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Connex-Brothers-Consulting-Group"
    }
  },
  "description": "AGENTIC WORKSPACE AI OS PLATFORM 2.0"
}

{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CONNEX",
  "appearance": {
    "default": "dark"
  },
  "colors": {
    "primary": "#003DB3",
    "light": "#003DB3",
    "dark": "#D55E08"
  },
  "favicon": {
    "light": "/favicon-light.webp",
    "dark": "/favicon-dark.webp"
  },
  "logo": {
    "light": "/logo/light.webp",
    "dark": "/logo/dark.webp"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "quickstart",
              "architecture"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "features/coworx",
              "features/agent",
              "features/vfs"
            ]
          },
          {
            "group": "Security & Tenancy",
            "pages": [
              "governance/data-sovereignty",
              "governance/zero-trust-auth",
              "governance/compliance"
            ]
          }
        ]
      },
      {
        "tab": "Releases & Support",
        "groups": [
          {
            "group": "Ecosystem Updates",
            "pages": [
              "releases",
              "notices",
              "faq"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "CONNEX Web App",
          "href": "https://connex.cloud",
          "icon": "globe"
        },
        {
          "anchor": "HybridSphere Portal",
          "href": "https://hybridsphere.io",
          "icon": "shield-check"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Releases",
        "href": "/releases"
      },
      {
        "label": "Notices",
        "href": "/notices"
      },
      {
        "label": "FAQ",
        "href": "/faq"
      },
      {
        "label": "Support",
        "href": "mailto:support@hybridsphere.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch CONNEX",
      "href": "https://connex.cloud"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Connex-Brothers-Consulting-Group"
    }
  },
  "description": "AGENTIC WORKSPACE AI OS PLATFORM 2.0"
}

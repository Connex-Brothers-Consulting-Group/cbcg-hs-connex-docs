{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CONNEX Cloud OS",
  "colors": {
    "primary": "#003DB3",
    "light": "#D55E08",
    "dark": "#002266"
  },
  "fonts": {
    "heading": {
      "family": "Plus Jakarta Sans",
      "weight": 500
    },
    "body": {
      "family": "Plus Jakarta Sans",
      "weight": 300
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart",
          "architecture"
        ]
      },
      {
        "group": "Core Features",
        "pages": [
          "features/coworx",
          "features/agent",
          "features/vfs"
        ]
      },
      {
        "group": "Governance & Security",
        "pages": [
          "governance/data-sovereignty",
          "governance/zero-trust-auth",
          "governance/compliance"
        ]
      },
      {
        "group": "Releases & Support",
        "pages": [
          "releases",
          "notices",
          "faq"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "CONNEX Web App",
          "href": "https://connex.cloud",
          "icon": "globe"
        },
        {
          "anchor": "HybridSphere Portal",
          "href": "https://hybridsphere.io",
          "icon": "shield-check"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Releases",
        "href": "/releases"
      },
      {
        "label": "Notices",
        "href": "/notices"
      },
      {
        "label": "FAQ",
        "href": "/faq"
      },
      {
        "label": "Support",
        "href": "mailto:support@hybridsphere.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch CONNEX",
      "href": "https://connex.cloud"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Connex-Brothers-Consulting-Group"
    }
  }
}